{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./node_modules/@cubing/dev-config/biome/biome.json"],
  "files": {
    "includes": [
      "**",
      "!dotfiles/vscode/**/*",
      "!exported",
      "!mirrored/vscode-settings-macos/files",
      "!dotfiles/karabiner/.config/karabiner/karabiner.json"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "useAwait": "error"
      },
      "correctness": {
        "useImportExtensions": {
          "level": "error"
        }
      }
    }
  }
}
