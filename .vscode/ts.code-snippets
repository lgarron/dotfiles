{
  "Optique boilerplate (dotfiles)": {
    "scope": "typescript",
    "prefix": "Optique boilerplate (dotfiles)",
    "body": [
      "#!/usr/bin/env -S bun run --",
      "",
      "import { object } from \"@optique/core\";",
      "import { run } from \"@optique/run\";",
      "import { byOption, fileTransformation, simpleFileInOut } from \"../lib/optique\";",
      "",
      "function parseArgs() {",
      "  return run(",
      "    object({",
      "      ...simpleFileInOut,",
      "    }),",
      "    byOption(),",
      "  );",
      "}",
      "",
      "export async function ${1:executeScript}(",
      "  args: ReturnType<typeof parseArgs>,",
      "): Promise<void> {",
      "  ${2:${TM_SELECTED_TEXT:const { outputFile, printAndMaybeReveal \\} = fileTransformation(args, \".ext\");",
      "  console.log(`\\${args.sourceFile\\} → \\${outputFile\\}`);",
      "  await printAndMaybeReveal();}}",
      "}",
      "",
      "if (import.meta.main) {",
      "  await ${1:executeScript}(parseArgs());",
      "}",
      ""
    ]
  }
}
